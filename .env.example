# ------------------------------------------------------------------------------
# SUPABASE (DATABASE, AUTH, STORAGE)
# ------------------------------------------------------------------------------
# Found in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Can be generated in Supabase project settings -> Database -> Password.
# Used for migrations and server-side actions that require elevated privileges.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# EMBEDDING PROVIDER (OpenAI or Google Gemini)
# ------------------------------------------------------------------------------
# The service to use for generating vector embeddings. "openai" or "google".
EMBEDDING_PROVIDER=openai
# Your API key for the chosen provider.
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# EMAIL (BREVO / SMTP)
# ------------------------------------------------------------------------------
# Used for sending daily job digests.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="OneSearch Job <noreply@onesearch.com>"

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
# The public URL of your application. Used for links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# INGESTION - TIER B (HIGH-RISK SOURCES)
# ------------------------------------------------------------------------------
# Master switch for all high-risk, scraper-based sources (Tier B).
# If false, only stable Tier A sources (ATS feeds) will be ingested.
ENABLE_HIGH_RISK_SOURCES=false

# Individual feature flags for each Tier B source.
# These are only active if ENABLE_HIGH_RISK_SOURCES is true.
ENABLE_LINKEDIN=false
ENABLE_NAUKRI=false
ENABLE_INSTAHYRE=false
ENABLE_INDEED=false

# ------------------------------------------------------------------------------
# SCRAPING INFRASTRUCTURE
# ------------------------------------------------------------------------------
# URL to your rotating proxy pool (e.g., Luminati, BrightData, ScraperAPI).
# Required if ENABLE_HIGH_RISK_SOURCES is true.
PROXY_POOL_URL=

# Whether to rotate user agents for scraping requests. Recommended for Tier B.
USER_AGENT_ROTATION=true

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# A secret token to protect the manual refresh and digest endpoints.
ADMIN_TOKEN=your_super_secret_admin_token

# A 32-character secret key for any at-rest encryption needs.
ENCRYPTION_KEY=your_super_secret_32_character_key
